df = df.fillna(df.mean(numeric_only = True))

cols = df.select_dtypes(include = "number").columns 
print(cols)

sns.boxplot(data=df[cols])
plt.xticks(rotation=45)
plt.title("Boxplot for Outlier Detection")
plt.show()

for i in cols :
    Q1 = df[i].quantile(0.25)
    Q3 = df[i].quantile(0.75)

    IQR = Q3-Q1

    lower = Q1-1.5*IQR
    upper = Q3+1.5*IQR
    
    df = df[(df[i] <= upper)&(df[i] >= lower)]

for col in cols:
    mean = df[col].mean()
    std = df[col].std()
    
    z_score = (df[col] - mean) / std
    
    # Keep only values where |z| <= 3
    df = df[z_score.abs() <= 3]



sns.boxplot(data=df[cols])
plt.xticks(rotation=45)
plt.title("Boxplot for Outlier Detection")
plt.show()


# Min-Max Scaling
minmax = MinMaxScaler()
df['Marks_norm'] = minmax.fit_transform(df[['math_score']])

# Standardization
std = StandardScaler()
df['Marks_std'] = std.fit_transform(df[['math_score']])

df.skew(numeric_only=True)

