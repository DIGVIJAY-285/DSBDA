4. Program 2: Bubble Sort
Step 1: Go to working directory
cd ~/DSBDAL_31424
Step 2: Create file
nano bubblesort.scala
Step 3: Write code
val arr = Array(5, 2, 8, 1, 3)
var rdd = sc.parallelize(arr)
for(i <- 0 until arr.length) {
rdd = rdd.mapPartitions(iter => {
val a = iter.toArray
for(j <- 0 until a.length-1) {
if(a(j) > a(j+1)) {
val temp = a(j)
a(j) = a(j+1)
a(j+1) = temp
}
}
a.iterator
})
}
println("Sorted array:")
rdd.collect().foreach(x => print(x + " "))
